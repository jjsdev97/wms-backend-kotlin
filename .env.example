# docker compose 비밀 주입용 템플릿.
#   1) 이 파일을 .env 로 복사하고 (cp .env.example .env)
#   2) 값을 32바이트 이상 임의 문자열로 채운 뒤
#   3) docker compose --profile full up
#
# .env 는 .gitignore 에 등록돼 git에 커밋되지 않는다.
# compose는 같은 폴더의 .env 를 자동으로 읽어 ${APP_JWT_SECRET} 치환에 사용한다.
APP_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
