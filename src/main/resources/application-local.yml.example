# 로컬 개발용 비밀값 템플릿.
#   1) 이 파일을 같은 폴더에 application-local.yml 로 복사하고
#   2) secret 값을 32바이트 이상 임의 문자열로 채운 뒤
#   3) 'local' 프로필로 실행:  ./gradlew bootRun --args='--spring.profiles.active=local'
#
# application-local.yml 은 .gitignore 에 등록돼 git에 커밋되지 않는다.
# 운영 환경에서는 이 파일 대신 환경변수 APP_JWT_SECRET 로 주입한다.
app:
  jwt:
    secret: change-me-to-a-random-string-at-least-32-bytes-long
  security:
    exposure:
      mcp-public: true
      dev-endpoints-public: true

spring:
  graphql:
    graphiql:
      enabled: true
