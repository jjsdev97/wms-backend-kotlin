type Query {
    "전체 재고 조회"
    inventories: [InventoryItem!]!
    "단건 재고 조회"
    inventory(id: ID!): InventoryItem
}

type Mutation {
    "재고 증감 (delta 음수면 차감)"
    adjustStock(id: ID!, delta: Int!): InventoryItem!
    "예약 생성. reservationId는 멱등 자연키 (같은 키 재호출 시 중복 차감 없음)"
    reserveStock(id: ID!, reservationId: String!, amount: Int!): InventoryItem!
    "출고 확정. 예약 전체를 확정 (이미 확정된 예약이면 no-op)"
    confirmStock(id: ID!, reservationId: String!): InventoryItem!
    "예약 취소. 예약 전체를 취소 (이미 취소된 예약이면 no-op)"
    cancelReservation(id: ID!, reservationId: String!): InventoryItem!
}

type InventoryItem {
    id: ID!
    sku: String!
    warehouseId: String!
    quantity: Int!
    reserved: Int!
    available: Int!
    version: Int!
    updatedAt: String!
}
